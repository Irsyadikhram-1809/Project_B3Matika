APP_NAME=B3Matika
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laragon (Auto Virtual Host): nama folder proyek + .test  ->  C:\laragon\www\b3matika  =>  http://b3matika.test
# Jika memakai "php artisan serve", ganti menjadi http://localhost:8000
APP_URL=http://b3matika.test
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default: SQLite (tanpa setup database). File: database/database.sqlite
DB_CONNECTION=sqlite

# Pakai MySQL bawaan Laragon? Buat database "b3matika" lewat HeidiSQL, lalu aktifkan 6 baris ini
# (dan beri tanda # pada DB_CONNECTION=sqlite di atas):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=b3matika
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

BCRYPT_ROUNDS=12

# Masa berlaku token login (menit). 10080 = 7 hari
SANCTUM_EXPIRATION=10080
