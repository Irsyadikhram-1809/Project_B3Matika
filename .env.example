# ==============================================================
# ENVIRONMENT VARIABLES B3MATIKA
# File ini hanya contoh (template). Jangan masukkan nilai asli!
# Salin file ini ke .env.local dan isi nilainya.
# ==============================================================

# ===== A. KREDENSIAL SUPERADMIN (Hanya untuk seeder, bukan login) =====
# Email dan username untuk akun superadmin utama
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=
# Password untuk di-hash oleh seeder (minimal 12 karakter)
SUPERADMIN_PASSWORD=
# Opsional: Email notifikasi untuk permintaan admin (default: SUPERADMIN_EMAIL)
SUPERADMIN_NOTIFY_EMAIL=

# ===== B. TOKEN & KEAMANAN ADMIN =====
# String acak rahasia (min 32 byte) untuk HMAC token admin & link
# Cara generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_TOKEN_SECRET=
# Masa berlaku token setelah disetujui (dalam jam)
ADMIN_TOKEN_TTL_HOURS=24
# Masa berlaku pengajuan pending (dalam hari)
ADMIN_REQUEST_EXPIRY_DAYS=7
# Masa berlaku link persetujuan di email (dalam jam)
ADMIN_APPROVAL_LINK_TTL_HOURS=48

# ===== C. KONFIGURASI APLIKASI =====
# URL dasar aplikasi (contoh: https://b3matika.vercel.app atau http://localhost:3000)
# Tidak boleh diakhiri garis miring (/)
APP_BASE_URL=
# Secret untuk menandatangani JWT sesi login (min 16 karakter)
JWT_SECRET=
# Environment: 'development' atau 'production'
NODE_ENV=
# Port untuk local server
PORT=3000

# ===== D. EMAIL SMTP (Nodemailer) =====
EMAIL_USER=
# App Password Gmail (bukan password akun)
EMAIL_PASS=
# Secret untuk hashing OTP
OTP_SECRET=

# ===== E. SUPABASE DATABASE =====
# URL REST Supabase
SUPABASE_URL=
# Kunci rahasia untuk backend (memiliki akses bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=
# URL koneksi langsung PostgreSQL
DATABASE_URL=
# Bucket untuk menyimpan foto profil avatar
SUPABASE_AVATAR_BUCKET=avatars
# Batas ukuran upload avatar dalam byte (default: 2097152 = 2MB)
AVATAR_MAX_BYTES=2097152

# ===== F. API EKSTERNAL =====
# API Key untuk integrasi AI Tutor (Google Gemini)
GEMINI_API_KEY=

# ===== G. FRONTEND EXPOSED (Hati-hati!) =====
# Hanya variabel berawalan VITE_ yang akan terlihat di browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== H. RATE LIMITING (Opsional) =====
LOGIN_MAX_ATTEMPTS=5
ADMIN_REQUEST_MAX_PER_DAY=3
