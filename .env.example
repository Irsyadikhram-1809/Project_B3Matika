APP_NAME=B3Matika
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default: SQLite (tanpa setup database). File: database/database.sqlite
DB_CONNECTION=sqlite

# Pakai MySQL? (Railway menyediakan ini secara otomatis)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=b3matika
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync

BCRYPT_ROUNDS=12

# Masa berlaku token login (menit). 10080 = 7 hari
SANCTUM_EXPIRATION=10080

# ===== GEMINI AI TUTOR =====
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ===== CORS (Production) =====
# URL frontend React di Vercel. Pisahkan beberapa domain dengan koma.
# Contoh: https://b3matika.vercel.app,https://b3matika.com
FRONTEND_URL=http://localhost:5173
